# Editor / IDE
.history/
.vscode/
*.code-workspace

# Arduino / Teensy build artifacts
build/
*.hex
*.elf
# ...but DO ship the pre-compiled firmware the flasher flashes
!_FLASHER/ichosynth.hex
# TŒRN port build output (rebuild with teensy/build_toern.py)
teensy/firmware/

# Backup archives (PCB/enclosure exports)
_DOCS/**/*.zip

# Generated asset previews / PDF render checks (review only, not committed)
assets/_preview/
assets/_pdfcheck/

# Python bytecode cache
__pycache__/
*.pyc

# OS cruft
Thumbs.db
.DS_Store

# Local Claude / ralph-loop runtime artifacts
.claude/settings.local.json
.claude/ralph-task.md
.claude/ralph-loop.local.md

# Emulator / firmware runtime artifacts (written when running the emulator)
eeprom.bin
midi-log.txt
midi-map.txt
settings.txt
_SDCARD/autosaved.txt
_SDCARD/settings.txt
# user recordings (runtime content, not shipped). The factory browser library
# _SDCARD/samples/<kick|snare|hat|clap|tom|perc|fx>/ IS shipped.
_SDCARD/samples/9/

# 3D case: render intermediates (rebuild with _CASE/render/render.ps1). The raw PNGs
# stay local; the guide uses the optimized _CASE/img/*.jpg + the out/*.json overlays.
_CASE/render/build/
_CASE/render/out/*.png


# PDF build tooling deps
scripts/pdf/node_modules/
