# Editor / IDE
.history/
.vscode/
*.code-workspace

# Arduino / Teensy build artifacts
build/
*.hex
*.elf
# ...but DO ship the pre-compiled firmware the flasher flashes
!tools/flasher/ichosynth.hex
# TŒRN port build output (rebuild with firmware/build_toern.py)
firmware/build/

# Backup archives (PCB/enclosure exports)
legacy/**/*.zip
docs/**/*.zip

# Generated asset previews / PDF render checks (review only, not committed)
assets/_preview/
assets/_pdfcheck/

# Python bytecode cache
__pycache__/
*.pyc

# OS cruft
Thumbs.db
.DS_Store

# Local Claude / ralph-loop runtime artifacts
.claude/settings.local.json
.claude/ralph-task.md
.claude/ralph-loop.local.md

# Emulator / firmware runtime artifacts (written when running the emulator)
eeprom.bin
midi-log.txt
midi-map.txt
settings.txt
sdcard/autosaved.txt
sdcard/settings.txt
# user recordings (runtime content, not shipped). The factory browser library
# sdcard/samples/<kick|snare|hat|clap|tom|perc|fx>/ IS shipped.
sdcard/samples/9/

# 3D case: render intermediates (rebuild with case/render/render.ps1). The raw PNGs
# stay local; the guide uses the optimized case/img/*.jpg + the out/*.json overlays.
case/render/build/
case/render/out/*.png


# PDF build tooling deps
tools/pdf/node_modules/
